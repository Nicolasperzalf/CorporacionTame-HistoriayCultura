// Configuración de Cloudflare (Workers con archivos estáticos).
// El sitio sigue siendo estático: Cloudflare sirve la carpeta tal cual, sin compilar nada.
{
  "name": "corporaciontame-historiaycultura",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "."
  },
  // Único acceso público: el dominio propio (corporaciontamehistoriaycultura.co, conectado en Cloudflare).
  // Se apagan la dirección *.workers.dev y los enlaces de vista previa de cada versión o rama.
  "workers_dev": false,
  "preview_urls": false
}
